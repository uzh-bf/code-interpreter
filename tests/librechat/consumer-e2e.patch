+import { readFile } from 'node:fs/promises';
+import { expect, test } from '@playwright/test';
+import type { TFile } from 'librechat-data-provider';
+import type { Page } from '@playwright/test';
+
+type AgentResponse = { id: string };
+type PersistedMessage = {
+  messageId?: string;
+  parentMessageId?: string;
+  isCreatedByUser?: boolean;
+  unfinished?: boolean;
+  error?: boolean;
+  endpoint?: string;
+  thread_id?: string;
+  content?: Array<{ type?: string }>;
+};
+type OwnedResources = {
+  agentId?: string;
+  conversationId?: string;
+  fileIds: Set<string>;
+};
+
+const appBaseURL = new URL(process.env.E2E_BASE_URL as string);
+appBaseURL.pathname = appBaseURL.pathname.replace(/\/?$/, '/');
+const newChatURL = new URL('c/new', appBaseURL);
+const liveCodeE2E = process.env.E2E_CODE_LIVE === 'true';
+const codeProvider = process.env.E2E_CODE_PROVIDER?.trim() ?? '';
+const codeModel = process.env.E2E_CODE_MODEL?.trim() ?? '';
+const workerDeadlineMs = Number(process.env.E2E_CODE_WORKER_DEADLINE_MS);
+const inputContent = 'name,value\nalpha,1\nbeta,2\n';
+const expectedContent = 'name,value\nALPHA,2\nBETA,4\n';
+
+const uniqueName = (prefix: string) =>
+  prefix + ' ' + Date.now() + '-' + Math.floor(Math.random() * 1e4);
+const conversationIdFromURL = (url: string) => {
+  const match = new URL(url).pathname.match(/\/c\/([^/]+)\/?$/);
+  const conversationId = match?.[1];
+  return conversationId && conversationId !== 'new'
+    ? decodeURIComponent(conversationId)
+    : undefined;
+};
+
+async function getAccessToken(page: Page): Promise<string> {
+  const result = await page.evaluate(async (baseURL) => {
+    const response = await fetch(new URL('api/auth/refresh', baseURL), {
+      method: 'POST',
+      credentials: 'include',
+      headers: { 'Content-Type': 'application/json' },
+      body: JSON.stringify({}),
+    });
+    const body = (await response.json().catch(() => null)) as { token?: string } | null;
+    return { ok: response.ok, status: response.status, token: body?.token };
+  }, appBaseURL.toString());
+  if (!result.ok || !result.token) {
+    throw new Error('[e2e:deployed] Existing authentication state could not refresh.');
+  }
+  return result.token;
+}
+
+async function apiRequest<T>(
+  page: Page,
+  path: string,
+  token: string,
+  method = 'GET',
+  body?: unknown,
+): Promise<T> {
+  const result = await page.evaluate(
+    async ({ baseURL, requestPath, accessToken, requestMethod, requestBody }) => {
+      const headers: Record<string, string> = { Authorization: 'Bearer ' + accessToken };
+      const init: RequestInit = { method: requestMethod, credentials: 'include', headers };
+      if (requestBody !== undefined) {
+        headers['Content-Type'] = 'application/json';
+        init.body = JSON.stringify(requestBody);
+      }
+      const response = await fetch(new URL(requestPath, baseURL), init);
+      const text = await response.text();
+      let json: unknown = null;
+      try {
+        json = text ? JSON.parse(text) : null;
+      } catch {
+        json = null;
+      }
+      return { ok: response.ok, status: response.status, json };
+    },
+    {
+      baseURL: appBaseURL.toString(),
+      requestPath: path,
+      accessToken: token,
+      requestMethod: method,
+      requestBody: body,
+    },
+  );
+  if (!result.ok) {
+    throw new Error('[e2e:deployed] API request failed with status ' + result.status + '.');
+  }
+  return result.json as T;
+}
+
+async function getPersistedMessages(
+  page: Page,
+  conversationId: string,
+  token: string,
+): Promise<{ status: number; messages?: PersistedMessage[] }> {
+  return page.evaluate(
+    async ({ baseURL, id, accessToken }) => {
+      const response = await fetch(new URL('api/messages/' + encodeURIComponent(id), baseURL), {
+        credentials: 'include',
+        headers: { Authorization: 'Bearer ' + accessToken },
+      });
+      if (!response.ok) {
+        return { status: response.status };
+      }
+      return {
+        status: response.status,
+        messages: (await response.json()) as PersistedMessage[],
+      };
+    },
+    { baseURL: appBaseURL.toString(), id: conversationId, accessToken: token },
+  );
+}
+
+async function loadAuthenticatedApp(page: Page) {
+  await page.addInitScript((appOrigin) => {
+    if (location.origin === appOrigin) {
+      localStorage.setItem('isTemporary', 'false');
+      localStorage.setItem('defaultTemporaryChat', 'false');
+    }
+  }, appBaseURL.origin);
+  await page.goto(newChatURL.toString(), { waitUntil: 'domcontentloaded' });
+  await expect(page.getByTestId('text-input')).toBeVisible({ timeout: 20_000 });
+  await expect(page).toHaveURL(/\/c\/new\/?$/);
+}
+
+async function createCodeAgent(page: Page, name: string): Promise<AgentResponse> {
+  return apiRequest<AgentResponse>(page, 'api/agents', await getAccessToken(page), 'POST', {
+    name,
+    instructions: 'Use code execution to follow the user request exactly.',
+    provider: codeProvider,
+    model: codeModel,
+    model_parameters: { temperature: 0 },
+    tools: ['execute_code'],
+    stateful_code_sessions: false,
+  });
+}
+
+async function selectAgent(page: Page, agentName: string) {
+  const selector = page.getByTestId('model-selector-button');
+  await selector.click();
+  await page.getByRole('option', { name: 'My Agents' }).click();
+  await page.getByRole('option', { name: agentName, exact: true }).click();
+  await expect(selector).toContainText(agentName);
+}
+
+async function attachCodeFile(page: Page, filename: string) {
+  const directUpload = page.locator('button#attach-file-button');
+  const menuTrigger = page.getByRole('button', { name: 'Attach File Options', exact: true });
+  await expect(directUpload.or(menuTrigger)).toBeVisible();
+  const [chooser] = await Promise.all([
+    page.waitForEvent('filechooser'),
+    (async () => {
+      if (await directUpload.isVisible()) {
+        await directUpload.click();
+        return;
+      }
+      await menuTrigger.click();
+      const codeUpload = page.getByRole('menuitem', {
+        name: 'Upload to Code Environment',
+        exact: true,
+      });
+      const localUpload = page.getByRole('menuitem', { name: 'From Local Computer', exact: true });
+      await expect(codeUpload.or(localUpload)).toBeVisible();
+      await ((await codeUpload.isVisible()) ? codeUpload : localUpload).click();
+    })(),
+  ]);
+  const expectedPath = new URL('api/files', appBaseURL).pathname;
+  const [upload] = await Promise.all([
+    page.waitForResponse(
+      (response) =>
+        new URL(response.url()).pathname === expectedPath && response.request().method() === 'POST',
+      { timeout: workerDeadlineMs },
+    ),
+    chooser.setFiles({
+      name: filename,
+      mimeType: 'text/csv',
+      buffer: Buffer.from(inputContent),
+    }),
+  ]);
+  expect(upload.ok(), 'CodeAPI input upload should succeed').toBeTruthy();
+  let uploadedFileId: string | undefined;
+  try {
+    const body = await upload.text();
+    const payloads = upload.headers()['content-type']?.includes('text/event-stream')
+      ? body
+          .split(/\r?\n/)
+          .filter((line) => line.startsWith('data:'))
+          .map((line) => JSON.parse(line.slice(5)))
+      : [JSON.parse(body)];
+    uploadedFileId = payloads
+      .reverse()
+      .find((payload: { file_id?: string }) => typeof payload.file_id === 'string')?.file_id;
+  } catch {
+    throw new Error('The upload did not return its file identity.');
+  }
+  if (!uploadedFileId) throw new Error('The upload did not return its file identity.');
+  ownedResources.fileIds.add(uploadedFileId);
+  await expect(page.getByText(filename).first()).toBeVisible();
+}
+
+async function waitForConversationCompletion(page: Page, conversationId: string) {
+  let token = await getAccessToken(page);
+  await expect
+    .poll(
+      async () => {
+        let result = await getPersistedMessages(page, conversationId, token);
+        if (result.status === 401) {
+          token = await getAccessToken(page);
+          result = await getPersistedMessages(page, conversationId, token);
+        }
+        const messages = result.messages;
+        if (!messages) {
+          return false;
+        }
+        const userMessageIds = new Set(
+          messages
+            .filter((message) => message.isCreatedByUser === true)
+            .map((message) => message.messageId),
+        );
+        const assistantMessages = messages.filter(
+          (message) =>
+            message.isCreatedByUser === false &&
+            message.parentMessageId != null &&
+            userMessageIds.has(message.parentMessageId),
+        );
+        return (
+          userMessageIds.size > 0 &&
+          assistantMessages.length > 0 &&
+          assistantMessages.every(
+            (message) =>
+              message.unfinished === false &&
+              message.error !== true &&
+              message.content?.some((part) => part.type === 'error') !== true,
+          )
+        );
+      },
+      { timeout: workerDeadlineMs * 2 },
+    )
+    .toBe(true);
+}
+
+async function filesFor(page: Page): Promise<TFile[]> {
+  return apiRequest<TFile[]>(page, 'api/files', await getAccessToken(page));
+}
+
+async function waitForArtifact(
+  page: Page,
+  conversationId: string,
+  filename: string,
+): Promise<TFile> {
+  let artifact: TFile | undefined;
+  await expect
+    .poll(
+      async () => {
+        artifact = (await filesFor(page)).find(
+          (file) =>
+            file.filename === filename &&
+            file.metadata?.codeEnvRef?.executionProfile === 'default' &&
+            file.conversationId === conversationId,
+        );
+        return artifact != null;
+      },
+      { timeout: workerDeadlineMs * 2 },
+    )
+    .toBe(true);
+  if (!artifact) {
+    throw new Error('[e2e:deployed] CodeAPI did not publish the expected run artifact.');
+  }
+  return artifact;
+}
+
+async function cleanupOwned(page: Page, resources: OwnedResources) {
+  const failures: string[] = [];
+  let token: string | undefined;
+  try {
+    token = await getAccessToken(page);
+  } catch {
+    failures.push('refresh test authentication');
+  }
+
+  if (token) {
+    let files: TFile[] = [];
+    if (resources.conversationId || resources.fileIds.size > 0) {
+      try {
+        files = await apiRequest<TFile[]>(page, 'api/files', token);
+      } catch {
+        failures.push('list test-owned files');
+      }
+    }
+    const ownedFiles = files.filter(
+      (file) =>
+        (resources.conversationId != null && file.conversationId === resources.conversationId) ||
+        resources.fileIds.has(file.file_id),
+    );
+    if (ownedFiles.length > 0) {
+      try {
+        await apiRequest(page, 'api/files', token, 'DELETE', { files: ownedFiles });
+      } catch {
+        failures.push('delete test-owned files');
+      }
+    }
+
+    if (resources.conversationId) {
+      try {
+        const messages = await apiRequest<PersistedMessage[]>(
+          page,
+          'api/messages/' + encodeURIComponent(resources.conversationId),
+          token,
+        );
+        const latestWithEndpoint = messages
+          .slice()
+          .reverse()
+          .find((message) => message.endpoint);
+        const latestWithThread = messages
+          .slice()
+          .reverse()
+          .find((message) => message.thread_id);
+        await apiRequest(page, 'api/convos', token, 'DELETE', {
+          arg: {
+            conversationId: resources.conversationId,
+            endpoint: latestWithEndpoint?.endpoint,
+            thread_id: latestWithThread?.thread_id,
+            source: 'e2e-deployed-codeapi',
+          },
+        });
+      } catch {
+        failures.push('delete test-owned conversation');
+      }
+    }
+
+    if (resources.agentId) {
+      try {
+        await apiRequest(
+          page,
+          'api/agents/' + encodeURIComponent(resources.agentId),
+          token,
+          'DELETE',
+        );
+      } catch {
+        failures.push('delete test-owned agent');
+      }
+    }
+  }
+  if (failures.length > 0) {
+    throw new Error('[e2e:deployed] Cleanup failed: ' + [...new Set(failures)].join(', '));
+  }
+}
+
+let ownedResources: OwnedResources = { fileIds: new Set() };
+
+test.describe('deployed CodeAPI consumer smoke', () => {
+  test.skip(
+    !liveCodeE2E,
+    'Set E2E_CODE_LIVE=true to select the operator-only deployed CodeAPI smoke.',
