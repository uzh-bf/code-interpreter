+    guestTimeoutMs: 2000,
+  });
+  const child = spawn('/bin/bash', ['-c', program.command], {
+    detached: true,
+    stdio: ['ignore', 'ignore', 'pipe'],
+  });
+  const closed = once(child, 'close');
+  let output = '';
+  try {
+    await new Promise((resolve, reject) => {
+      const timeout = setTimeout(() => reject(new Error('Start marker was not emitted')), 750);
+      child.stderr.on('data', (chunk) => {
+        output += chunk.toString('utf8');
+        if (output.length > 512) {
+          clearTimeout(timeout);
+          reject(new Error('Start marker exceeded its bound'));
+        }
+        if (output.includes('\n')) {
+          clearTimeout(timeout);
+          resolve();
+        }
+      });
+      child.once('error', (error) => {
+        clearTimeout(timeout);
+        reject(error);
+      });
+    });
+    const fields = output.trim().split(':');
+    assert.equal(fields[0], 'CODEAPI_E2E_START');
+    assert.equal(fields[1], CASE_ID);
+    assert.equal(Number.isFinite(Number(fields[2])), true);
+    assert.equal(Number(fields[2]) > 0, true);
+  } finally {
+    if (child.pid) {
+      try {
+        process.kill(-child.pid, 'SIGTERM');
+      } catch {
+        /* The fixture can already have exited. */
+      }
+    }
+    await closed;
+  }
