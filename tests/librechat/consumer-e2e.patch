+async function waitForCancellationEvidence<T extends object>(
+  correlation: string,
+  select: (events: CancellationEvidenceEvent[], receivedAtMs: number) => T | undefined,
+  timeout: number,
+): Promise<T> {
+  let selected: T | undefined;
+  let failure: unknown;
+  await expect
+    .poll(
+      async () => {
+        try {
+          selected = select(await readCancellationEvidence(correlation), Date.now());
+          return selected ? 'ready' : 'pending';
+        } catch (error) {
+          failure = error;
+          return 'invalid';
+        }
+      },
+      { timeout },
+    )
+    .not.toBe('pending');
+  if (failure) throw failure;
+  if (!selected) throw new Error('The operator receipt did not contain the required evidence.');
+  return selected;
+}
+
+async function waitForGuestStartEvidence(selectedCase: CancellationCase) {
+  return waitForCancellationEvidence(
+    selectedCase.correlation,
+    (events, receivedAtMs) => {
+      const starts = events.filter(
+        (event): event is GuestStartedEvidence => event.event === 'guest-started',
+      );
+      if (starts.length > 1) throw new Error('Guest-start evidence is duplicated.');
+      if (starts.length === 0) return undefined;
+      validateGuestStartEvidence(starts[0], selectedCase, receivedAtMs);
+      return { start: starts[0], receivedAtMs };
+    },
+    WORKER_DEADLINE_MS,
+  );
+}
+
+async function waitForTerminalCancellationEvidence(
+  start: GuestStartedEvidence,
+  selectedStop: CancellationStop,
+) {
+  return waitForCancellationEvidence(
+    selectedStop.correlation,
+    (events, receivedAtMs) => {
+      const starts = events.filter(
+        (event): event is GuestStartedEvidence => event.event === 'guest-started',
+      );
+      const terminals = events.filter(
+        (event): event is TerminalCancellationEvidence => event.event === 'terminal',
+      );
+      const serviceChecks = events.filter(
+        (event): event is ServiceObjectsEvidence => event.event === 'service-objects-checked',
+      );
+      if (starts.length !== 1 || terminals.length > 1 || serviceChecks.length > 1) {
+        throw new Error('Cancellation completion evidence is duplicated.');
+      }
+      if (terminals.length === 0 || serviceChecks.length === 0) return undefined;
+      /** The completion receipt republishes the start interval intersected with
+       *  the post-case bracket; it may narrow the pre-Stop interval, never widen it. */
+      if (
+        starts[0].programStartedLowerMs < start.programStartedLowerMs ||
+        starts[0].programStartedUpperMs > start.programStartedUpperMs
+      ) {
+        throw new Error('Completion evidence widened the pre-Stop guest start interval.');
+      }
+      validateCancellationCompletionEvidence(
+        starts[0],
+        terminals[0],
+        serviceChecks[0],
+        selectedStop,
+        receivedAtMs,
+      );
+      return { terminal: terminals[0], service: serviceChecks[0] };
+    },
+    selectedStop.programHorizonMs + OUTPUT_PERSISTENCE_GRACE_MS + WORKER_DEADLINE_MS * 2,
+  );
+}
+
+async function stopGeneration(page: Page): Promise<number> {
+  const stop = page.getByRole('button', { name: 'Stop generating' });
+  await expect(stop).toBeVisible();
+  const abortResponse = page.waitForResponse(
+    (candidate) =>
+      candidate.request().method() === 'POST' &&
+      new URL(candidate.url()).pathname === '/api/agents/chat/abort',
+    { timeout: WORKER_DEADLINE_MS },
+  );
+  const stopInitiatedAtMs = Date.now();
+  await stop.click();
+  const response = await abortResponse;
+  expect(response.ok(), 'server should accept the Stop request').toBeTruthy();
+  await expect(stop).toBeHidden({ timeout: WORKER_DEADLINE_MS });
+  return stopInitiatedAtMs;
+}
+
+async function waitForCodeApiResponseEvidence(
+  correlation: string,
+  scenario: CodeApiResponseEvidence['scenario'],
+): Promise<CodeApiResponseEvidence> {
+  let matching: CodeApiResponseEvidence[] = [];
+  await expect
+    .poll(
+      async () => {
+        matching = (await readCodeApiResponseEvidence()).filter(
+          (event) => event.correlation === correlation && event.scenario === scenario,
+        );
+        return matching.length;
+      },
+      { timeout: WORKER_DEADLINE_MS * 2 },
+    )
+    .toBe(1);
+  return matching[0];
+}
 
