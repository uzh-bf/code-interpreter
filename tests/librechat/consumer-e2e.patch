+'use strict';
+
+const crypto = require('node:crypto');
+const fs = require('node:fs');
+const path = require('node:path');
+const { performance } = require('node:perf_hooks');
+
+const MAX_CASES = 32;
+const MAX_CODE_BYTES = 16 * 1024;
+const MAX_EVIDENCE_BYTES = 16 * 1024;
+const MAX_EVIDENCE_LINE_BYTES = 512;
+const MAX_DURATION_MS = 120_000;
+const SCENARIOS = new Set(['cancel', 'timeout']);
+const TERMINAL_STATUSES = new Set(['TO', 'completed', 'cancelled', 'failed', 'error']);
+const SIGNALS = new Set(['SIGABRT', 'SIGINT', 'SIGKILL', 'SIGTERM']);
+
+function digest(code) {
+  return crypto.createHash('sha256').update(code).digest('hex');
+}
+
+function safeCode(value) {
+  if (Number.isSafeInteger(value) && value >= 0 && value <= 255) return value;
+  if (typeof value === 'string' && /^[A-Za-z0-9_.-]{1,64}$/.test(value)) return value;
+  return undefined;
+}
+
+function safeStatus(value) {
+  return typeof value === 'string' && TERMINAL_STATUSES.has(value) ? value : undefined;
+}
+
+function isTargetRequest(args) {
+  const input = args[0];
+  const rawUrl = typeof input === 'string' ? input : input?.url;
+  if (typeof rawUrl !== 'string') return false;
+  let url;
+  try {
+    url = new URL(rawUrl);
+  } catch {
+    return false;
+  }
+  const method = args[1]?.method ?? input?.method ?? 'GET';
+  return (
+    method === 'POST' && (url.pathname.endsWith('/v1/exec') || url.pathname.endsWith('/v1/exec/'))
+  );
+}
+
+function requestCode(args) {
+  const body = args[1]?.body;
+  if (typeof body !== 'string' || Buffer.byteLength(body) > MAX_CODE_BYTES * 2) return undefined;
+  try {
+    const payload = JSON.parse(body);
+    return typeof payload?.code === 'string' && Buffer.byteLength(payload.code) <= MAX_CODE_BYTES
+      ? payload.code
+      : undefined;
+  } catch {
+    return undefined;
+  }
+}
+
+function createObserver({ evidencePath, now = () => performance.now() } = {}) {
+  if (evidencePath != null && !path.isAbsolute(evidencePath)) {
+    throw new TypeError('CodeAPI observer evidence path must be absolute.');
+  }
+
+  const registrations = new Map();
+
+  function registerCase({ correlation, scenario, code }) {
+    if (typeof evidencePath !== 'string') {
+      throw new Error('CodeAPI response observer is not enabled for this app process.');
+    }
+    if (
+      typeof correlation !== 'string' ||
+      !/^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$/.test(correlation) ||
+      !SCENARIOS.has(scenario) ||
+      typeof code !== 'string' ||
+      Buffer.byteLength(code) === 0 ||
+      Buffer.byteLength(code) > MAX_CODE_BYTES
+    ) {
+      throw new TypeError('Invalid synthetic CodeAPI observer registration.');
+    }
+    if (registrations.size >= MAX_CASES) {
+      throw new RangeError('CodeAPI response observer registration limit reached.');
+    }
+    const codeDigest = digest(code);
+    if (registrations.has(codeDigest)) {
+      throw new Error('Duplicate synthetic CodeAPI observer registration.');
+    }
+    registrations.set(codeDigest, { correlation, scenario });
+  }
+
+  function appendEvidence(event) {
+    let line;
+    try {
+      line = JSON.stringify(event) + '\n';
+      const lineBytes = Buffer.byteLength(line);
+      if (lineBytes > MAX_EVIDENCE_LINE_BYTES) return;
+      fs.mkdirSync(path.dirname(evidencePath), { recursive: true });
+      const flags = fs.constants.O_APPEND | fs.constants.O_CREAT | fs.constants.O_WRONLY;
+      const fd = fs.openSync(evidencePath, flags | (fs.constants.O_NOFOLLOW ?? 0), 0o600);
+      try {
+        const stats = fs.fstatSync(fd);
+        if (
+          !stats.isFile() ||
+          stats.size + lineBytes > MAX_EVIDENCE_BYTES ||
+          stats.size + lineBytes > MAX_CASES * MAX_EVIDENCE_LINE_BYTES
+        ) {
+          return;
+        }
+        fs.writeSync(fd, line, null, 'utf8');
+      } finally {
+        fs.closeSync(fd);
+      }
+    } catch {
+      // Evidence failure leaves the original request and response untouched.
+    }
+  }
+
+  function captureResponse(registration, response, startedAt) {
+    if (typeof response?.json !== 'function') return;
+    const originalJson = response.json;
+    try {
+      Object.defineProperty(response, 'json', {
+        configurable: true,
+        writable: true,
+        value: function observedJson(...args) {
+          const result = Reflect.apply(originalJson, this, args);
+          if (result && typeof result.then === 'function') {
+            result.then(
+              (payload) => {
+                const durationMs = Math.min(
+                  MAX_DURATION_MS,
+                  Math.max(0, Math.round(now() - startedAt)),
+                );
+                const status = safeStatus(payload?.status);
+                const code = safeCode(payload?.code);
+                const event = {
+                  correlation: registration.correlation,
+                  scenario: registration.scenario,
+                  httpStatus:
+                    Number.isInteger(response.status) &&
+                    response.status >= 100 &&
