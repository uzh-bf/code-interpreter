+    userId: descriptor.auth.user_id,
+    database: descriptor.database,
+    env,
+  });
+  validateUserContext(user, descriptor, lifecycle.control.authFixture, env);
+  const provider = String(env.CODEAPI_AUTH_PROVIDER ?? '').trim();
+  if (provider !== 'librechat-jwt' && provider !== 'both') {
+    throw new Error('CodeAPI JWT signing must be enabled by the known local provider');
+  }
+  const headers = await signHeaders({
+    user: {
+      id: descriptor.auth.user_id,
+      _id: descriptor.auth.user_id,
+      tenantId: descriptor.auth.tenant_id,
+      role: descriptor.auth.role,
+      provider: 'local',
+    },
+    authStrategy: 'jwt',
+  });
+  if (
+    !headers ||
+    typeof headers.Authorization !== 'string' ||
+    !/^Bearer [A-Za-z0-9._-]{16,4096}$/.test(headers.Authorization)
+  ) {
+    throw new Error('The CodeAPI signer did not return a bounded bearer header');
+  }
+  const url = buildListingUrl(
+    descriptor.urls.codeapi,
+    lifecycle.guest.outputSessionId,
+    descriptor.auth.user_id,
+  );
+  const target = lifecycle.naturalCompletion.upperMs + descriptor.output_persistence_grace_ms;
+  let checkedThroughMs = 0;
+  for (;;) {
+    if (now() > deadline) {
+      throw new Error('CodeAPI listing did not complete before the registration expiry');
+    }
+    const sentAt = now();
+    const payload = await listFiles({
+      url,
+      headers: { Authorization: headers.Authorization },
+      timeoutMs: Math.max(1, Math.min(5_000, deadline - now())),
+    });
+    const matchingObjectCount = validateListingPayload(payload, {
+      outputSessionId: lifecycle.guest.outputSessionId,
+      outputBasename: descriptor.registration.output_basename,
+    });
+    if (matchingObjectCount !== 0) {
+      throw new Error('The cancelled execution published its declared late output');
+    }
+    checkedThroughMs = Math.max(checkedThroughMs, sentAt);
+    if (checkedThroughMs >= target) break;
+    await sleep(Math.min(POLL_INTERVAL_MS, Math.max(1, target - checkedThroughMs)));
+  }
+  const events = buildReceiptEvents(lifecycle, checkedThroughMs, now(), startObservedAtMs);
+  writeReceipt(outputPath, events);
+  return { descriptor, lifecycle, events };
+}
+
+function safeMessage() {
+  // Native errors may contain credentials or transport details; never export their text.
+  return 'Cancellation verification failed; inspect the bounded private evidence.';
+}
+
+function parseCliArgs(argv) {
+  const allowed = new Set(['descriptor', 'control', 'guest', 'calibration', 'output']);
+  const values = {};
+  for (let index = 0; index < argv.length; index += 2) {
+    const flag = argv[index];
+    const value = argv[index + 1];
+    if (!flag || !flag.startsWith('--') || !allowed.has(flag.slice(2)) || value === undefined) {
+      throw new Error('Expected only the approved bounded descriptor and receipt paths');
+    }
+    const name = flag.slice(2);
+    if (Object.hasOwn(values, name)) throw new Error('Duplicate cancellation producer flag');
+    values[name] = value;
+  }
+  for (const name of allowed) {
+    if (!Object.hasOwn(values, name))
+      throw new Error(`Missing --${name} cancellation producer path`);
+  }
+  return values;
+}
+
+async function main(argv, env = process.env) {
+  if (env.CI) {
+    throw new Error('The CodeAPI cancellation receipt producer is operator-only.');
+  }
+  const args = parseCliArgs(argv);
+  await runProducer({
+    descriptorPath: args.descriptor,
+    controlPath: args.control,
+    guestPath: args.guest,
+    calibrationPath: args.calibration,
+    outputPath: args.output,
+    env,
+  });
+  process.stdout.write('codeapi-cancellation-receipts: ok\n');
+}
+
+module.exports = {
+  DIAGNOSTIC,
+  DESCRIPTOR_VERSION,
+  MAX_GUEST_BYTES,
+  MAX_GUEST_LINE_BYTES,
+  MAX_GUEST_RECORDS,
+  createCancellationProgram,
+  parseRegistration,
+  parseDescriptor,
+  readDescriptor,
+  splitJsonLines,
+  parseControl,
+  parseCalibration,
+  clockOffsetInterval,
+  preOffsetInterval,
+  mapGuestInterval,
+  parseGuest,
+  evaluateLifecycle,
+  evaluateStart,
+  validateListingPayload,
+  validateUserContext,
+  buildListingUrl,
+  buildReceiptEvents,
+  buildStartEvent,
+  writeReceipt,
+  runProducer,
+  parseCliArgs,
+  main,
+  safeMessage,
+  parseMongoDbName,
+  defaultReadUser,
+  defaultSignHeaders,
+  defaultListFiles,
+  readBoundedResponseText,
+};
+
+if (require.main === module) {
+  main(process.argv.slice(2)).catch((error) => {
+    process.stderr.write(`codeapi-cancellation-receipts: ${safeMessage(error)}\n`);
+    process.exitCode = 1;
+  });
+}
