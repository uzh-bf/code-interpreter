+    !isInterval(naturalCompletion.lowerMs, naturalCompletion.upperMs) ||
+    start.naturalCompletionLowerMs !== naturalCompletion.lowerMs ||
+    start.naturalCompletionUpperMs !== naturalCompletion.upperMs
+  ) {
+    throw new Error('The synthetic program horizon is invalid.');
