+    writeObserver.registerCase({
+      correlation: 'timeout-run-6',
+      scenario: 'timeout',
+      code: writeCode,
+    });
+    const parsed = { status: 'TO' };
+    const jsonPromise = Promise.resolve(parsed);
+    const writeResponse = {
+      status: 200,
+      json() {
+        return jsonPromise;
+      },
+    };
+    const networkPromise = Promise.resolve(writeResponse);
+    const writeFetch = writeObserver.wrapFetch(() => networkPromise);
+    assert.equal(
+      writeFetch('https://codeapi.invalid/v1/exec', {
+        method: 'POST',
+        body: JSON.stringify({ code: writeCode }),
+      }),
+      networkPromise,
+    );
+    assert.equal(await networkPromise, writeResponse);
+    assert.equal(writeResponse.json(), jsonPromise);
+    assert.equal(await jsonPromise, parsed);
+    assert.equal(fs.statSync(blockedPath).isDirectory(), true);
+  });
+});
