+export function validateCancellationCompletionEvidence(
+  start: GuestStartedEvidence,
+  terminal: TerminalCancellationEvidence,
+  service: ServiceObjectsEvidence,
+  selectedStop: CancellationStop,
+  receivedAtMs: number,
+): void {
+  const naturalCompletion = validateGuestStartEvidence(
+    start,
+    selectedStop,
+    selectedStop.startReceivedAtMs,
+  );
+  if (
+    !isTimestamp(receivedAtMs) ||
+    !isTimestamp(selectedStop.stopInitiatedAtMs) ||
+    !isTimestamp(selectedStop.outputPersistenceGraceMs) ||
+    selectedStop.startReceivedAtMs > selectedStop.stopInitiatedAtMs ||
+    start.observedAtMs > selectedStop.stopInitiatedAtMs ||
+    selectedStop.stopInitiatedAtMs >= naturalCompletion.lowerMs ||
+    selectedStop.stopInitiatedAtMs > receivedAtMs ||
+    terminal?.event !== 'terminal' ||
+    terminal.correlation !== selectedStop.correlation ||
+    terminal.outputName !== selectedStop.outputName ||
+    terminal.terminalStatus !== 'cancelled' ||
+    terminal.guestProcessesRemaining !== 0 ||
+    terminal.rootOutputPresent !== false ||
+    terminal.naturalCompletionLowerMs !== naturalCompletion.lowerMs ||
+    terminal.naturalCompletionUpperMs !== naturalCompletion.upperMs ||
+    !isInterval(terminal.terminalLowerMs, terminal.terminalUpperMs) ||
+    !isInterval(terminal.guestTreeExitedLowerMs, terminal.guestTreeExitedUpperMs) ||
+    !isInterval(terminal.rootOutputCheckedLowerMs, terminal.rootOutputCheckedUpperMs) ||
+    !isInterval(terminal.releasedLowerMs, terminal.releasedUpperMs) ||
+    terminal.terminalUpperMs > receivedAtMs ||
+    terminal.guestTreeExitedUpperMs > receivedAtMs ||
+    terminal.rootOutputCheckedUpperMs > receivedAtMs ||
+    terminal.releasedUpperMs > receivedAtMs ||
+    !isTimestamp(terminal.observedAtMs) ||
+    terminal.observedAtMs > receivedAtMs ||
+    terminal.terminalLowerMs < selectedStop.stopInitiatedAtMs ||
+    terminal.guestTreeExitedLowerMs < selectedStop.stopInitiatedAtMs ||
+    // These facts share one guest clock mapping; common offset uncertainty
+    // does not reverse their causal order. Cross-clock Stop/horizon bounds stay conservative.
+    terminal.rootOutputCheckedLowerMs < terminal.guestTreeExitedLowerMs ||
+    terminal.rootOutputCheckedUpperMs < terminal.guestTreeExitedUpperMs ||
+    terminal.releasedLowerMs < terminal.terminalLowerMs ||
+    terminal.releasedUpperMs < terminal.terminalUpperMs ||
+    terminal.releasedLowerMs < terminal.rootOutputCheckedLowerMs ||
+    terminal.releasedUpperMs < terminal.rootOutputCheckedUpperMs ||
+    terminal.releasedUpperMs >= naturalCompletion.lowerMs ||
+    terminal.observedAtMs < terminal.releasedUpperMs
+  ) {
+    throw new Error('Guest cancellation or release is not bound to Stop and the program horizon.');
+  }
+  if (
+    service?.event !== 'service-objects-checked' ||
+    service.correlation !== selectedStop.correlation ||
+    service.outputName !== selectedStop.outputName ||
+    service.matchingObjectCount !== 0 ||
+    !isTimestamp(service.checkedThroughMs) ||
+    !isTimestamp(service.observedAtMs) ||
+    service.checkedThroughMs < naturalCompletion.upperMs + selectedStop.outputPersistenceGraceMs ||
+    service.observedAtMs < service.checkedThroughMs ||
+    service.observedAtMs > receivedAtMs
+  ) {
+    throw new Error(
+      'Independent service-object absence has not been observed through the horizon.',
+    );
+  }
+}
