+'use strict';
+
+/**
+ * Operator-only cancellation receipt coordinator.
+ *
+ * The parent wrapper owns the guest-log/calibration transport and starts this
+ * process with a bounded, non-secret descriptor. This module never listens on a
+ * socket, never starts the application, and never persists signing material.
+ * It validates one case-only guest JSONL stream, maps the guest clock with
+ * conservative intervals and, after the natural horizon plus grace, checks the
+ * user-private CodeAPI listing with the real signer and the real local user
+ * database projection.
+ */
+
+const crypto = require('node:crypto');
+const fs = require('node:fs');
+const path = require('node:path');
+
+const DIAGNOSTIC = 'codeapi-lifecycle-v1';
+const DESCRIPTOR_VERSION = 'codeapi-cancellation-descriptor-v1';
+
+const MAX_DESCRIPTOR_BYTES = 4 * 1024;
